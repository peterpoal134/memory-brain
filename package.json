{
  "name": "dsh-memory-brain",
  "version": "0.2.4",
  "type": "module",
  "description": "Memory Brain: standalone evidence-first memory kernel, DSH adapter and local 3D control panel",
  "license": "AGPL-3.0-only",
  "main": "./adapters/dsh/memory-brain.mjs",
  "icon": "./xiaojiu_brain/static/icons/brain.svg",
  "exports": {
    ".": "./adapters/dsh/memory-brain.mjs",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-agent-loop": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-compaction-basic": "*",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "*",
    "@deepseek-ai/dsh-token-meter": "*",
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-loop": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-tool-result-pruner": {
      "optional": true
    },
    "@deepseek-ai/dsh-token-meter": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "files": [
    "client/*.js",
    "adapters/dsh/*.mjs",
    "adapters/dsh/*.md",
    "adapters/dsh/package.json",
    "xiaojiu_brain/*.py",
    "xiaojiu_brain/static/*.html",
    "xiaojiu_brain/static/*.css",
    "xiaojiu_brain/static/*.js",
    "xiaojiu_brain/static/*.svg",
    "xiaojiu_brain/static/icons/*.svg",
    "xiaojiu_brain/static/icons/*.md",
    "xiaojiu_brain/static/cortex/*.bin",
    "xiaojiu_brain/static/cortex/*.json",
    "xiaojiu_brain/static/cortex/*.md",
    "xiaojiu_brain/static/vendor/*.md",
    "wheels/*.whl",
    "docs/DSH-INSTALL.md",
    "docs/DSH-DESKTOP-COMPAT.md",
