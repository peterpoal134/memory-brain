    "docs/BACKGROUND-DERIVATION.md",
    "docs/CHAT-USAGE.md",
    "docs/BRANDING.md",
    "docs/CONTRACT.md",
    "docs/DAILY-STATE-RULES.md",
    "docs/LIFE-LAYER.md",
    "docs/MEMORY-MAP.md",
    "docs/OBSERVATORY-API.md",
    "docs/PROFILE-IMPORTANT.md",
